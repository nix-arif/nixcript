{
  "name": "nixcript",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db-prod:push": "drizzle-kit push",
    "db-dev:push": "dotenv -e .env.local -- drizzle-kit push",
    "db-dev:migrate": "tsx db/apply-pending-migrations.ts",
    "audit:permissions": "tsx scripts/audit-permissions.ts",
    "audit:roles": "tsx scripts/audit-roles.ts",
    "test:seed": "dotenv -e .env.local -- tsx scripts/seed-test-env.ts",
    "test:clear-so": "dotenv -e .env.local -- tsx scripts/clear-test-docs.ts",
    "test:e2e": "dotenv -e .env.local -- playwright test",
    "test:e2e:ui": "dotenv -e .env.local -- playwright test --ui",
    "test:e2e:debug": "dotenv -e .env.local -- playwright test --debug"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-email/components": "^1.0.12",
    "better-auth": "^1.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.8.0",
    "nanoid": "^5.1.11",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.1",
    "resend": "^6.12.0",
    "shadcn": "^4.2.0",
    "slugify": "^1.6.9",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@smithy/types": "4.14.1"
    }
  }
}
